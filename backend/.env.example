# Optional OpenAI-compatible chat completions provider. Leave blank to use the local generator.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional stock-media provider keys (server-side only; never expose these in the browser).
# Pexels supports photos and videos: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay supports photos and videos: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Unsplash supports photos only: https://unsplash.com/documentation
UNSPLASH_ACCESS_KEY=

# Optional local project/export storage path. Defaults to ./data
# MOTION_DATA_DIR=./data
